function getRealtimeClockText() {
  const now = new Date();
  const formatter = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta',
    weekday: 'long',
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });
  return `🕐 <b>${formatter.format(now)} WIB</b>`;
}

bot.onText(/^\/start$/, (msg) => {
