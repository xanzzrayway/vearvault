function safeFileName(url) {
  try {
    const u = new URL(url);
    return u.hostname.replace(/[^a-z0-9.-]/gi, '_');
  } catch {
    return 'source';
  }
}

function sanitizeProjectName(name) {
  return name
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9-]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 52) || 'myweb';
}

